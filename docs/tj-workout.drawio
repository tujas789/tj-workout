        <mxCell id="test" value="วันทดสอบ (แบด)&#10;&#10;อยู่นอกวง — บันทึกแยกด้วยการ์ด&#10;&quot;หลังลงสนามแบด&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c7e8d0;strokeColor=#14110d;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="c1">
