        <mxCell id="r_b" value="วันยิม ต้องห่างวันทดสอบ ≥ 2 วัน&#10;(ขาหนักกับแบดแย่งการฟื้นตัวกัน)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe9c7;strokeColor=#14110d;strokeWidth=2;fontSize=12;" vertex="1" parent="c1">
