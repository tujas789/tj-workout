        <mxCell id="fall" value="ติดกติกาหมด → เสนอ &quot;ปั่นเบา 20 นาที&quot;&#10;พร้อมบอกว่าข้ามอะไรเพราะอะไร" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1efe6;strokeColor=#8c8678;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="c1">
