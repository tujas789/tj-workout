        <mxCell id="n58" value="💡 ยืนปลายเท้าบนขอบบันได ปล่อยส้นลงต่ำสุด ขึ้น-ลงอย่างละ 3 วินาที" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fillColor=#f1efe6;strokeColor=#cfcabd;dashed=1;fontSize=10;fontColor=#4f4a40" vertex="1" parent="p1">
