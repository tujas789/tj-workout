        <mxCell id="n106" value="💡 มือยันเก้าอี้ หลังตรงขนานพื้น ดึงศอกไปหลังสะโพก บีบสะบักค้าง 1 วินาที" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fillColor=#f1efe6;strokeColor=#cfcabd;dashed=1;fontSize=10;fontColor=#4f4a40" vertex="1" parent="p1">
